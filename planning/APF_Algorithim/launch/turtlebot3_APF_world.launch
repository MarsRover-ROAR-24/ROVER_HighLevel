<launch>
  <arg name="model" default="waffle_pi"/>
  <arg name="x_pos" default="4.5"/>
  <arg name="y_pos" default="0.5"/>
  <arg name="z_pos" default="0.0"/>
  <arg name="map_file" default="$(find APF_Algorithim)/APF_Map/APF_Rviz.yaml"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="/home/shams/turtlebot_ws/src/APF_Algorithim/APF_Map/APF_World.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find turtlebot3_description)/urdf/turtlebot3_waffle_pii.urdf.xacro" />

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf" args="-urdf -model turtlebot3_turtlebot3_waffle_pii -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -param robot_description" />

  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find APF_Algorithim)/RVIZ/rviz.rviz"/>

  <node pkg="APF_Algorithim" name="APF" type="APF.py">
    <param name="x_Goal" value="0.5" />   
    <param name="y_Goal" value="4.5" />
    <param name="x_Obs" value="1.9885000032372773" />   
    <param name="y_Obs" value="1.9696000032126904" />
    <param name="K_att" value="8" />   
    <param name="K_rep" value="100" /> 
    <param name="q_star" value="1.4" /> 
    <param name="tau" value="0.1" /> 
    <param name="rob_mass" value="1.8" /> 
  </node>

  <node pkg="APF_Algorithim" name="Lyapunov" type="Lyapunov.py">
    <param name="K_x" value="2" />   
    <param name="K_theta" value="2" />
    <param name="Vd_des" value="0.001" />   
    <param name="Omega_des" value="0" />
  </node>


  <node pkg="rqt_graph" name="rqt_graph" type="rqt_graph"/>

  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)">
    <param name="frame_id" value="map"/> 
  </node>

  <arg name="static_tf" default="true"/>
  <node if="$(arg static_tf)" pkg="tf2_ros" type="static_transform_publisher" name="odom_wrt_map_tf" args="0 0 0 0 0 0 map odom"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0"/>
  </node>
 
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"/>

  <node name="potential_field" pkg="APF_Algorithim" type="vis_apf.py" output="screen"/> 

</launch>
